server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /health {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"status":"ok","commit":"${APP_COMMIT}"}';
    }

    location = /stub_status {
        stub_status;
        allow all;
    }

    location / {
        try_files $uri $uri/ /index.html =404;
    }
}
